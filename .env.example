# Firebase Web App config — get these from:
# Firebase Console -> Project settings -> General -> Your apps -> Web app
# Copy this file to ".env" and fill in the values.

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# These have sensible defaults for project school-management-system-79732,
# override only if different:
# VITE_FIREBASE_AUTH_DOMAIN=school-management-system-79732.firebaseapp.com
# VITE_FIREBASE_DATABASE_URL=https://school-management-system-79732-default-rtdb.firebaseio.com
# VITE_FIREBASE_PROJECT_ID=school-management-system-79732
# VITE_FIREBASE_STORAGE_BUCKET=school-management-system-79732.appspot.com
